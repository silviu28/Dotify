{
  "name": "dotify",
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "electron:dev": "concurrently -k \"npm run start\" \"wait-on http://localhost:4200 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "electron:start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:build": "ng build --configuration electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:pack": "ng build --configuration electron && env -u ELECTRON_RUN_AS_NODE electron-builder"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "dotenv": "^17.2.3",
    "music-metadata": "^11.10.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.dotify.app",
    "productName": "Dotify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/Dotify/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/LogoDotifyFavIcon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.music"
    }
  }
}
